# ─────────────────────────────────────────────
# CVBoost AI — Environment Variables
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_ENV=development            # development | production
APP_SECRET_KEY=CHANGE_ME_32_CHAR_RANDOM_STRING
APP_ALLOWED_ORIGINS=["http://localhost:8501"]

# ── Database ─────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./cvboost.db
# PostgreSQL (production): postgresql+asyncpg://user:pass@host/db
    
# ── JWT ──────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_64_CHAR_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ── LLM Provider ─────────────────────────────
LLM_PROVIDER=groq                 # groq | gemini

# ── Groq AI (Fast & Free) ────────────────────
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# ── Gemini AI (Fallback) ─────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ── Tavily Search ────────────────────────────
TAVILY_API_KEY=your-tavily-api-key-here
SEARCH_PROVIDER=tavily            # tavily | duckduckgo

# ── SMTP (contact form) ──────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CVBoost AI <noreply@cvboost.ai>
CONTACT_RECIPIENT=contact@cvboost.ai

# ── Storage ──────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880          # 5 MB
MAX_PDF_PAGES=20

# ── Rate Limits ──────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AI=10/minute
RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_CONTACT=5/minute

# ── Google OAuth (optional) ──────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Redis (optional, for rate-limit + cache) ─
REDIS_URL=
CACHE_TTL_SECONDS=3600
